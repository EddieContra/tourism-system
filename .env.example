# Copy this file to .env and adjust. Real environment variables override it.
# Without a .env file the defaults below match a stock XAMPP install.

APP_ENV=local            # local | production
APP_DEBUG=false          # true shows PHP errors in the browser (never in production)
APP_URL=                 # e.g. https://fivestartours.example.com (optional)
APP_TIMEZONE=Africa/Dar_es_Salaam

DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourism
DB_USER=root
DB_PASS=

# Email (password reset links). When disabled, links are logged and, in local
# mode, shown on screen so the flow can be demonstrated without a mail server.
MAIL_ENABLED=false
MAIL_FROM=no-reply@fivestartours.test

COMPANY_ADDRESS="414 Meru Street, Sanawari, Arusha"
COMPANY_PHONE="+255 745 225 985"
COMPANY_EMAIL=info@fivestartours.test
